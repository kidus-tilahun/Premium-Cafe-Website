# Root environment configuration for the Premium Cafe monorepo.
#
# Copy this file to .env and fill in values for local development.
# Do not check .env into source control.

# Database settings
# DATABASE_URL="postgresql://postgres:password@localhost:5432/cafe_db"
DATABASE_URL=

# Supabase settings
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Backend configuration
BACKEND_PORT=3000
LOG_LEVEL=info

# Frontend configuration
FRONTEND_PORT=18881
BASE_PATH=/
API_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000

# Optional overrides
# NODE_ENV=development
